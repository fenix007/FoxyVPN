+func interactiveLoginError() error {
+	if os.Getenv("FOXYVPN_NONINTERACTIVE") == "1" {
+		return errors.New("no usable saved Firefox Account token; sign in again from the FoxyVPN app")
+	}
+	return nil
+}
+
+// Exit even if macOS kills the UI before it can terminate its child process.
+func watchParentProcess() error {
+	raw := os.Getenv("FOXYVPN_PARENT_PID")
+	if raw == "" {
+		return nil
+	}
+	parent, err := strconv.Atoi(raw)
+	if err != nil || parent <= 1 || parent != os.Getppid() {
+		return errors.New("FoxyVPN parent process is no longer running")
+	}
+	go func() {
+		ticker := time.NewTicker(250 * time.Millisecond)
+		defer ticker.Stop()
+		for range ticker.C {
+			if os.Getppid() != parent {
+				os.Exit(0)
+			}
+		}
+	}()
+	return nil
+}
