+func TestConfirmationWaitsForSessionAndHonorsCancellation(t *testing.T) {
+	calls := 0
+	err := waitForSessionConfirmation(context.Background(), "synthetic", time.Millisecond, func(context.Context, string) (bool, error) {
+		calls++
+		return calls == 3, nil
+	})
+	if err != nil || calls != 3 {
+		t.Fatalf("did not wait for confirmation: calls=%d err=%v", calls, err)
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	err = waitForSessionConfirmation(ctx, "synthetic", time.Hour, func(context.Context, string) (bool, error) { return false, nil })
+	if !errors.Is(err, context.Canceled) {
+		t.Fatalf("confirmation ignored cancellation: %v", err)
+	}
+}
