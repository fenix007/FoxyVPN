+// FxaSessionVerified checks the session itself, not just email ownership.
+func FxaSessionVerified(ctx context.Context, sessionToken string) (bool, error) {
+	hawkID, hawkKey, err := deriveHawkCredentials(sessionToken, "sessionToken")
+	if err != nil {
+		return false, err
+	}
+	endpoint := fxaAuthServer + "/session/status"
+	resp, err := fxaDo(ctx, func() (*http.Request, error) {
+		header, err := hawkHeader("GET", endpoint, hawkID, hawkKey, "")
+		if err != nil {
+			return nil, err
+		}
+		req, err := http.NewRequestWithContext(ctx, "GET", endpoint, nil)
+		if err != nil {
+			return nil, err
+		}
+		req.Header.Set("Authorization", header)
+		applyFxAHeaders(req)
+		return req, nil
+	})
+	if err != nil {
+		return false, err
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode != http.StatusOK {
+		return false, newFxaAPIError(resp.StatusCode, []byte(readErrorBody(resp.Body)))
+	}
+	var status struct {
+		Details struct {
+			AccountEmailVerified bool  `json:"accountEmailVerified"`
+			SessionVerified      bool  `json:"sessionVerified"`
+			MeetsAAL             *bool `json:"sessionVerificationMeetsMinimumAAL"`
+		} `json:"details"`
+	}
+	if err := json.NewDecoder(io.LimitReader(resp.Body, 64*1024)).Decode(&status); err != nil {
+		return false, err
+	}
+	return status.Details.AccountEmailVerified && status.Details.SessionVerified &&
+		(status.Details.MeetsAAL == nil || *status.Details.MeetsAAL), nil
+}
