+func waitForSessionConfirmation(ctx context.Context, session string, interval time.Duration, check func(context.Context, string) (bool, error)) error {
+	for {
+		ready, err := check(ctx, session)
+		if err != nil {
+			return err
+		}
+		if ready {
+			return nil
+		}
+		select {
+		case <-ctx.Done():
+			return fmt.Errorf("confirm Firefox sign-in in the login window or email, then try again: %w", ctx.Err())
+		case <-time.After(interval):
+		}
+	}
+}
